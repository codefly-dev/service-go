apiVersion: v1
kind: Service
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: {{ .Namespace }}
spec:
  selector:
    app: {{ .Service.Name.DNSCase }}
  ports:
    - protocol: TCP
      name: http
      port: {{ .Deployment.Parameters.HTTPPort }}
      targetPort: {{ .Deployment.Parameters.HTTPPort }}
