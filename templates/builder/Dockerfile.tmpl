# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Image tags live here so Dependabot can update the embedded build recipe.
# The Go modules the recipe declares it downloads (go_module_downloads), fetched
# by the caller on its own machine before any image build and supplied here as
# the build context of this name, in the Go module proxy layout. Without a
# caller supplying it, the stage is empty and the download below uses the
# network as it always did.
FROM scratch AS gomodproxy

# Build stage
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

RUN apk add --no-cache ca-certificates git

WORKDIR /app

COPY code/ ./code/
WORKDIR /app/code
ARG TARGETOS
ARG TARGETARCH

# Private Go modules. The recipe declares its module download, and the caller
# fetches it before the build and supplies it as the gomodproxy context above:
# the build reads the modules from there and needs no credential. GOPRIVATE, a
# build argument the CLI sets from the host's own, only matters when nothing was
# supplied — a plain `docker build` — where those module paths bypass the public
# proxy and checksum database and are fetched with git, with the optional netrc
# secret below. The credential is never a build argument, an ENV or a layer.
ARG GOPRIVATE

# With the caller's prefetched modules, they are the only module source: no
# credential is needed or mounted, a module missing from them fails here rather
# than being fetched, and go.sum alone verifies them (the caller's fetch was
# verified against the checksum database on its side). GOPRIVATE is cleared so
# private paths are read from the proxy like any other.
RUN --mount=type=bind,from=gomodproxy,target=/gomodproxy \
    --mount=type=secret,id=netrc,target=/root/.netrc,required=false \
    if [ -n "$(ls -A /gomodproxy)" ]; then export GOPROXY=file:///gomodproxy GOSUMDB=off GOPRIVATE= GONOPROXY= GONOSUMDB=; fi && \
    go mod download && go mod verify && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -ldflags='-w -s -extldflags "-static"' -o app

# Final stage
FROM alpine:3.24

RUN apk add --no-cache ca-certificates

WORKDIR /app

{{ range .Envs }}
ENV {{ .Key }}={{ .Value }}
{{ end }}

RUN adduser -D appuser
COPY --chown=appuser --from=builder /app/code/app .
USER appuser

EXPOSE 8080
CMD ["./app"]
